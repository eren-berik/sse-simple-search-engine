# Variables read by docker compose (copy to .env to override the defaults shown).
# Service-level settings are documented in README.md under "Konfigürasyon".

# Host ports
APP_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6379

LOG_LEVEL=info
SYNC_INTERVAL=10m

# Persistent JWT signing key for iam-service. Run `make keys`, then uncomment.
# Without it iam-service generates a new key on every start, which invalidates issued access tokens
# (the dashboard recovers by refreshing them).
# JWT_PRIVATE_KEY_FILE=/keys/jwt.pem
