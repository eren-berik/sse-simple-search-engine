# Required
DATABASE_URL=postgres://app:app@localhost:5433/contents?sslmode=disable

# Optional (defaults shown)
HTTP_ADDR=:8080
LOG_LEVEL=info
# Leave empty to use an in-process cache instead of Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=90s

PROVIDER1_URL=https://raw.githubusercontent.com/WEG-Technology/mock/refs/heads/main/v2/provider1
PROVIDER2_URL=https://raw.githubusercontent.com/WEG-Technology/mock/refs/heads/main/v2/provider2
PROVIDER_TIMEOUT=5s
PROVIDER_RATE_PER_SEC=2
PROVIDER_BURST=1
PROVIDER_MAX_RETRIES=3

SYNC_INTERVAL=10m

SCORE_VIDEO_COEFFICIENT=1.5
SCORE_TEXT_COEFFICIENT=1.0

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# Leave empty to disable admin endpoints
ADMIN_API_KEY=dev-admin-key
