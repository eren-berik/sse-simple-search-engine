    {
      "type": "stat",
      "title": "Açık devre",
      "description": "Açık circuit breaker sayısı: gateway → servis ve sse-service → provider.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(gateway_circuit_state == 2) or vector(0)) + (count(provider_circuit_state == 2) or vector(0))",
